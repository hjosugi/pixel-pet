{
  "name": "pixel-pet",
  "private": true,
  "version": "0.2.4",
  "type": "module",
  "license": "0BSD",
  "description": "A lightweight cyberpunk pixel desktop pet prototype built with Tauri v2 and TypeScript.",
  "bin": {
    "pixel-pet": "bin/pixel-pet.mjs"
  },
  "files": [
    "bin",
    "dist",
    "assets/pets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "assets:generate": "node tools/generate-pixel-assets.mjs",
    "assets:validate": "node tools/validate-pet-packs.mjs",
    "assets:check": "npm run assets:generate && npm run assets:validate && git diff --exit-code -- assets/pets",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "test": "vitest run",
    "preview:web": "node bin/pixel-pet.mjs",
    "check": "npm run build && npm run test && cargo check --manifest-path src-tauri/Cargo.toml",
    "updater:manifest": "node tools/write-updater-manifest.mjs",
    "release:binary": "tauri build --no-bundle",
    "release:bundle": "tauri build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "graphify:setup": "sh scripts/graphify.sh setup",
    "graphify:update": "sh scripts/graphify.sh update",
    "check:tauri-versions": "node tools/check-tauri-versions.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/plugin-autostart": "~2.7.0",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-updater": "~2.14.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "~2.12.4",
    "typescript": "^5.0.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@vitest/mocker@>=4.0.0 <4.1.12": "4.1.12",
    "nanoid@>=3.0.0 <3.3.18": "3.3.20",
    "source-map-js@>=1.0.0 <1.2.2": "1.2.2"
  }
}
